{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freedriver.io/schema/v1/appliances.json",
  "title": "ApplianceStateMessage (superseded)",
  "description": "SUPERSEDED by schema/v2/appliances.json. v1 used shared freedriver/v1/home/appliances and field name. Never live-commanded. Isolation is now instanceId (UUIDv4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appliances"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "appliedCommandId": {
      "type": ["string", "null"]
    },
    "appliances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "on"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "on": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
