{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freedriver.io/schema/v1/commands.json",
  "title": "ApplianceCommandMessage",
  "description": "Topic B: freedriver/v1/home/commands (retain=false, QoS 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "applianceId", "on"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "applianceId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "on": {
      "type": "boolean"
    }
  }
}
