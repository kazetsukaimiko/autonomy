{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freedriver.io/schema/v1/commands.json",
  "title": "ApplianceCommandMessage (superseded)",
  "description": "SUPERSEDED by schema/v2/commands.json. v1 used shared freedriver/v1/home/commands and field name. Never live-commanded. Isolation is now instanceId (UUIDv4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "name", "on"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "on": {
      "type": "boolean"
    }
  }
}
