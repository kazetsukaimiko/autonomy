{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "7bbfab0cb628d26c6abbcccbfa162ea82a13c99b",
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "version-file": "version.txt",
      "include-v-in-tag": true,
      "pull-request-title-pattern": "chore(release): release ${version}",
      "pull-request-footer": "\nRefs: #128",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "refactor",
          "section": "Refactors",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "perf",
          "section": "Performance",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Continuous Integration",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Styles",
          "hidden": true
        },
        {
          "type": "revert",
          "section": "Reverts",
          "hidden": true
        }
      ]
    }
  }
}
