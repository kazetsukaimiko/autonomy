####
# Autonomy Quarkus fast-jar.
#
# The image contains the fast-jar and the joystick package (`jstest`). It does
# not contain house config. Mount the two directories onto the container user's
# home so the process reads ~/.config/autonomy and ~/.config/jsonlink:
#
#   ./scripts/install-freedriver-mqtt-contract.sh
#   mvn -pl quarkus -am package -DskipTests
#   docker build -f src/main/docker/Dockerfile.jvm -t autonomy .
#
# Run from the quarkus module, after the fast-jar exists in target/quarkus-app.
# From the repo root the context is the quarkus directory:
#
#   docker build -f quarkus/src/main/docker/Dockerfile.jvm -t autonomy quarkus
#
#   docker run --rm -p 8080:8080 \
#     -v "$HOME/.config/autonomy:/home/autonomy/.config/autonomy" \
#     -v "$HOME/.config/jsonlink:/home/autonomy/.config/jsonlink" \
#     autonomy
#
# The process is the non-root user autonomy (uid 10001, home /home/autonomy).
# Those mounts must be readable by that uid. Give them write access only when
# the process should update mappings or connectors.json. Do not copy secrets
# into this image. MQTT stays off unless autonomy.mqtt.enabled=true is set at
# runtime, and the password file stays on the mount.
#
###
# linux/amd64 manifest of eclipse-temurin:23-jre-noble. JDK 23 matches the build.
FROM eclipse-temurin:23-jre-noble@sha256:dae8f3deeb48ba738c6ee0067db4b49a09683e613c63a235e34bf6b65efdc746

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends joystick \
    && rm -rf /var/lib/apt/lists/* \
    && command -v jstest >/dev/null

RUN groupadd --system --gid 10001 autonomy \
    && useradd --system --uid 10001 --gid autonomy \
        --home-dir /home/autonomy --no-create-home \
        --shell /usr/sbin/nologin autonomy \
    && mkdir -p /deployments \
        /home/autonomy/.config/autonomy \
        /home/autonomy/.config/jsonlink \
    && chown -R autonomy:autonomy /deployments /home/autonomy \
    && chmod 0755 /home/autonomy /home/autonomy/.config \
        /home/autonomy/.config/autonomy /home/autonomy/.config/jsonlink \
    && test -z "$(find /home/autonomy/.config -type f -print)"

COPY --chown=autonomy:autonomy target/quarkus-app/lib/ /deployments/lib/
COPY --chown=autonomy:autonomy target/quarkus-app/*.jar /deployments/
COPY --chown=autonomy:autonomy target/quarkus-app/app/ /deployments/app/
COPY --chown=autonomy:autonomy target/quarkus-app/quarkus/ /deployments/quarkus/

# House config and key files must not ride in next to the fast-jar.
RUN test -z "$(find /deployments /home/autonomy -type f \( \
        -name 'mappings_v2.json' -o -name 'connectors.json' -o -name 'sensor_history.json' \
        -o -name 'mqtt.pass' -o -name 'mqtt-password' -o -name '*.pem' -o -name '*.key' \
        -o -name '*secret*' \
    \) -print)"

ENV HOME=/home/autonomy \
    LANG=C.UTF-8

WORKDIR /deployments
EXPOSE 8080
USER autonomy

ENTRYPOINT ["java", "-Duser.home=/home/autonomy", "-Dquarkus.http.host=0.0.0.0", "-Dquarkus.http.port=8080", "-jar", "/deployments/quarkus-run.jar"]
